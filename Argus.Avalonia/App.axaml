<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Argus.Avalonia.App"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#EEF3F8" />
          <SolidColorBrush x:Key="AppPanelBackgroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AppPanelBorderBrush" Color="#CBD5E1" />
          <SolidColorBrush x:Key="AppHeaderBackgroundBrush" Color="#0B1F3A" />
          <SolidColorBrush x:Key="AppHeaderForegroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AppAccentBrush" Color="#1769E0" />
          <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#0F55BA" />
          <SolidColorBrush x:Key="AppAccentPressedBrush" Color="#0B438F" />
          <SolidColorBrush x:Key="AppHeadingBrush" Color="#10243E" />
          <SolidColorBrush x:Key="AppTextBrush" Color="#172033" />
          <SolidColorBrush x:Key="AppMutedTextBrush" Color="#526077" />
          <SolidColorBrush x:Key="AppSubtleBackgroundBrush" Color="#E4ECF5" />
          <SolidColorBrush x:Key="AppButtonBackgroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AppButtonForegroundBrush" Color="#172033" />
          <SolidColorBrush x:Key="AppButtonHoverBrush" Color="#E4ECF5" />
          <SolidColorBrush x:Key="AppDisabledBackgroundBrush" Color="#E5E9EF" />
          <SolidColorBrush x:Key="AppDisabledForegroundBrush" Color="#6B7587" />
          <SolidColorBrush x:Key="AppDangerBrush" Color="#B42318" />
          <SolidColorBrush x:Key="AppGridHeaderBrush" Color="#DCE7F3" />
          <SolidColorBrush x:Key="AppGridAlternateRowBrush" Color="#F6F9FC" />
          <SolidColorBrush x:Key="AppGridSelectionBrush" Color="#CFE2FF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#0E1726" />
          <SolidColorBrush x:Key="AppPanelBackgroundBrush" Color="#172337" />
          <SolidColorBrush x:Key="AppPanelBorderBrush" Color="#3B4C66" />
          <SolidColorBrush x:Key="AppHeaderBackgroundBrush" Color="#081426" />
          <SolidColorBrush x:Key="AppHeaderForegroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AppAccentBrush" Color="#5B9CFF" />
          <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#78ADFF" />
          <SolidColorBrush x:Key="AppAccentPressedBrush" Color="#3D82EC" />
          <SolidColorBrush x:Key="AppHeadingBrush" Color="#F3F7FC" />
          <SolidColorBrush x:Key="AppTextBrush" Color="#E8EEF7" />
          <SolidColorBrush x:Key="AppMutedTextBrush" Color="#B2BED0" />
          <SolidColorBrush x:Key="AppSubtleBackgroundBrush" Color="#22324A" />
          <SolidColorBrush x:Key="AppButtonBackgroundBrush" Color="#263752" />
          <SolidColorBrush x:Key="AppButtonForegroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AppButtonHoverBrush" Color="#344966" />
          <SolidColorBrush x:Key="AppDisabledBackgroundBrush" Color="#29364A" />
          <SolidColorBrush x:Key="AppDisabledForegroundBrush" Color="#9AA6B8" />
          <SolidColorBrush x:Key="AppDangerBrush" Color="#FF8A80" />
          <SolidColorBrush x:Key="AppGridHeaderBrush" Color="#253956" />
          <SolidColorBrush x:Key="AppGridAlternateRowBrush" Color="#1C2A40" />
          <SolidColorBrush x:Key="AppGridSelectionBrush" Color="#234F86" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <StreamGeometry x:Key="IconArgus">M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5C21.27 7.61 17 4.5 12 4.5zm0 12.5c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z</StreamGeometry>
      <StreamGeometry x:Key="IconList">M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z</StreamGeometry>
      <StreamGeometry x:Key="IconCheck">M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z</StreamGeometry>
      <StreamGeometry x:Key="IconSelection">M7 2l12 11.2-5.8.5 3.3 5.7-2.6 1.5-3.2-5.6L7 17V2z</StreamGeometry>
      <StreamGeometry x:Key="IconExternal">M19 19H5V5h7V3H5C3.89 3 3 3.9 3 5v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z</StreamGeometry>
      <StreamGeometry x:Key="IconAdd">M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z</StreamGeometry>
      <StreamGeometry x:Key="IconEdit">M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM14.06 6.19l3.75 3.75 1.9-1.9-3.75-3.75-1.9 1.9z</StreamGeometry>
      <StreamGeometry x:Key="IconDelete">M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM8 9h8v10H8V9zm7.5-5-1-1h-5l-1 1H5v2h14V4z</StreamGeometry>
      <StreamGeometry x:Key="IconTheme">M9.37 5.51A7 7 0 0 0 18.49 14.63 7 7 0 1 1 9.37 5.51z</StreamGeometry>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Background" Value="{DynamicResource AppButtonBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppButtonForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppPanelBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,8" />
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppButtonHoverBrush}" />
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Background" Value="{DynamicResource AppDisabledBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppDisabledForegroundBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
    </Style>
    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppAccentHoverBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary:pressed">
      <Setter Property="Background" Value="{DynamicResource AppAccentPressedBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary:disabled">
      <Setter Property="Background" Value="{DynamicResource AppDisabledBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppDisabledForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppPanelBorderBrush}" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppDangerBrush}" />
    </Style>
    <Style Selector="Button.danger:disabled">
      <Setter Property="Foreground" Value="{DynamicResource AppDisabledForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppPanelBorderBrush}" />
    </Style>
    <Style Selector="ToggleButton.themeToggle">
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Background" Value="#143152" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#7DB2FF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Padding="{TemplateBinding Padding}"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Content="{TemplateBinding Content}"
                              Foreground="{TemplateBinding Foreground}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.themeToggle:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="White" />
    </Style>
    <Style Selector="ToggleButton.themeToggle:checked">
      <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="White" />
    </Style>
    <Style Selector="ToggleButton.themeToggle:checked:pointerover">
      <Setter Property="Background" Value="{DynamicResource AppAccentHoverBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ToggleButton.themeToggle:pressed">
      <Setter Property="Background" Value="{DynamicResource AppAccentPressedBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="CornerRadius" Value="0" />
    </Style>
  </Application.Styles>
</Application>
