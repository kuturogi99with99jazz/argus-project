<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Argus.Avalonia.ViewModels"
        x:Class="Argus.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Argus - Avalonia PoC"
        Width="960"
        Height="600"
        MinWidth="720"
        MinHeight="420">
  <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4">
        <TextBlock FontSize="28" FontWeight="SemiBold" Text="Argus" />
        <TextBlock Opacity="0.72" Text="登録したWebページの更新を手動で確認します" />
      </StackPanel>
      <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
        <TextBlock HorizontalAlignment="Right" Text="Avalonia UI PoC" />
        <TextBlock HorizontalAlignment="Right" FontWeight="Bold" IsVisible="{Binding IsDebug}" Text="DEBUG" />
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
      <Border Padding="12,6" CornerRadius="6" Background="{DynamicResource ControlAltFillColorSecondaryBrush}">
        <TextBlock Text="{Binding TargetSummary}" />
      </Border>
      <Border Padding="12,6" CornerRadius="6" Background="{DynamicResource ControlAltFillColorSecondaryBrush}">
        <TextBlock Text="{Binding CheckingSummary}" />
      </Border>
      <Border Padding="12,6" CornerRadius="6" Background="{DynamicResource ControlAltFillColorSecondaryBrush}">
        <TextBlock Text="{Binding SelectionSummary}" />
      </Border>
    </StackPanel>

    <WrapPanel Grid.Row="2" Orientation="Horizontal">
      <Button Margin="0,0,8,8" Command="{Binding CheckAllCommand}" Content="全件チェック" />
      <Button Margin="0,0,8,8" Command="{Binding CheckSelectedCommand}" Content="選択項目をチェック" />
      <Button Margin="0,0,8,8" Command="{Binding OpenBrowserCommand}" Content="ブラウザで開く" />
      <Button Margin="0,0,8,8" Command="{Binding AddCommand}" Content="追加" />
      <Button Margin="0,0,8,8" Command="{Binding EditCommand}" Content="編集" />
      <Button Margin="0,0,8,8" Command="{Binding DeleteCommand}" Content="削除" />
    </WrapPanel>

    <Grid Grid.Row="3" RowDefinitions="Auto,*">
      <Grid Margin="12,0,12,6" ColumnDefinitions="1.2*,1.8*,1.1*,0.6*,1.2*,1.4*" ColumnSpacing="10">
        <TextBlock FontWeight="SemiBold" Text="名前" />
        <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="URL" />
        <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="監視モード" />
        <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="有効" />
        <TextBlock Grid.Column="4" FontWeight="SemiBold" Text="状態" />
        <TextBlock Grid.Column="5" FontWeight="SemiBold" Text="最終チェック / エラー" />
      </Grid>
      <ListBox x:Name="TargetList"
               Grid.Row="1"
               ItemsSource="{Binding Rows}"
               SelectionMode="Multiple"
               SelectionChanged="TargetList_SelectionChanged">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:WatchTargetRowViewModel">
            <Grid Margin="4,6" ColumnDefinitions="1.2*,1.8*,1.1*,0.6*,1.2*,1.4*" ColumnSpacing="10">
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1" Text="{Binding Url}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="2" Text="{Binding ModeText}" TextWrapping="Wrap" />
              <TextBlock Grid.Column="3" Text="{Binding EnabledText}" />
              <TextBlock Grid.Column="4" Text="{Binding StatusText}" TextWrapping="Wrap" />
              <StackPanel Grid.Column="5">
                <TextBlock Text="{Binding LastCheckedText}" />
                <TextBlock Opacity="0.72" Text="{Binding ErrorText}" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <TextBlock VerticalAlignment="Center" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Opacity="0.68" Text="{Binding Copyright}" />
        <TextBlock Text="{Binding Version}" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
