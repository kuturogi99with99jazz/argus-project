<?xml version="1.0" encoding="utf-8"?>
<!-- Apple Silicon向け自己完結型Argus.app発行プロファイル。署名と公証は後続タスク。 -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <PublishDir>../artifacts/Argus-macos-arm64/Argus.app/Contents/MacOS/</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <UseAppHost>true</UseAppHost>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <Target Name="BuildMacAppBundle" AfterTargets="Publish">
    <PropertyGroup>
      <MacContentsDir>$(PublishDir)..</MacContentsDir>
      <MacResourcesDir>$(MacContentsDir)/Resources</MacResourcesDir>
    </PropertyGroup>
    <MakeDir Directories="$(MacResourcesDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/Packaging/macOS/Info.plist"
          DestinationFiles="$(MacContentsDir)/Info.plist" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../assets/argus-app-icon.icns"
          DestinationFiles="$(MacResourcesDir)/argus-app-icon.icns" />
    <ItemGroup>
      <MacPublishSymbols Include="$(PublishDir)**/*.pdb" />
    </ItemGroup>
    <Delete Files="@(MacPublishSymbols)" />
  </Target>
</Project>
